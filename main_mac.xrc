                                                                                </object>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                                                                    <border>4</border>
                                                                                    <object class="wxBitmapButton" name="ScreenDumpF5Xml">
                                                                                        <size>22,22</size>
                                                                                        <tooltip>Save video dump to file (F5)</tooltip>
                                                                                        <enabled>0</enabled>
                                                                                        <bitmap>images_osx/filesave.png</bitmap>
                                                                                    </object>
                                                                                </object>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_TOP|wxTOP|wxBOTTOM</flag>
                                                                            <border>2</border>
                                                                            <object class="wxStaticLine" name="wxID_STATIC">
