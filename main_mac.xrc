<?xml version="1.0" encoding="UTF-8"?>
<resource version="2.3.0.1" xmlns="http://www.wxwidgets.org/wxxrc">
    <object class="wxMenuBar" name="Main_Menu">
        <object class="wxMenu">
            <label>File</label>
            <object class="wxMenu" name="Config_Menu">
                <label>Configuration</label>
                <object class="wxMenuItem" name="MI_SaveOnExit">
                    <label>Save All on Exit</label>
                    <checkable>1</checkable>
                </object>
                <object class="wxMenuItem" name="MI_DefaultSettings">
                    <label>Set Default (All)</label>
                </object>
                <object class="wxMenu" name="XmlRomRam">
                    <label>XML ROM/RAM</label>
                    <object class="wxMenuItem" name="GUI">
                        <label>Latest from GUI (Default from XML)</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="XML">
                        <label>Always from XML</label>
                        <radio>1</radio>
                    </object>
                </object>
            </object>
            <object class="wxMenu" name="Re-install">
                <label>Re-install</label>
                <object class="wxMenuItem" name="MI_ReInstallData">
                    <label>1802 Software Files</label>
                </object>
                <object class="wxMenuItem" name="MI_ReInstallXml">
                    <label>XML Files</label>
                </object>
            </object>
            <object class="wxMenuItem" name="MI_DataDir">
                <label>Change Data Directory</label>
            </object>
            <object class="wxMenuItem" name="wxID_EXIT">
                <label>Exit</label>
            </object>
        </object>
        <object class="wxMenu">
            <label>Settings</label>
            <object class="wxMenuItem" name="MI_Psave">
                <label>Wav File and Real Cassette Settings</label>
            </object>
            <object class="wxMenu" name="Equalization ">
                <label>Equalization </label>
                <object class="wxMenuItem" name="Flat">
                    <label>Flat</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="Crisp">
                    <label>Crisp</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="Default">
                    <label>Default</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="TV Speaker">
                    <label>TV Speaker</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="Handheld">
                    <label>Handheld</label>
                    <radio>1</radio>
                </object>
            </object>
            <object class="wxMenu" name="WindowPos">
                <label>Window</label>
                <object class="wxMenuItem" name="MI_DefaultWindowPosition">
                    <label>Set Default Positions</label>
                </object>
                <object class="wxMenuItem" name="MI_DefaultGuiSize">
                    <label>Set Default Size</label>
                </object>
                <object class="wxMenu" name="MI_FontSize">
                    <label>Font Size (restart Emma 02!)</label>
                    <object class="wxMenuItem" name="MI_FontSize11">
                        <label>Standard</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="MI_FontSize14">
                        <label>Large</label>
                        <radio>1</radio>
                    </object>
                </object>
                <object class="wxMenuItem" name="MI_FixedWindowPosition">
                    <label>Fixed Positions</label>
                    <checkable>1</checkable>
                </object>
                <object class="wxMenuItem" name="MI_ActivateMain">
                    <label>Activate Main\tF2</label>
                    <enabled>0</enabled>
                </object>
                <object class="wxMenuItem" name="MI_FullScreen">
                    <label>Full Screen Mode\tF3</label>
                    <enabled>0</enabled>
                </object>
                <object class="wxMenuItem" name="MI_FullScreenFloat">
                    <label>Enable Floating Point Zooming</label>
                    <checkable>1</checkable>
                </object>
            </object>
            <object class="wxMenu" name="CpuType">
                <label>CPU Type</label>
                <object class="wxMenuItem" name="SYSTEM00">
                    <label>SYSTEM 00</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="CDP1801">
                    <label>CDP1801</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="CDP1802">
                    <label>CDP1802</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="CDP1804">
                    <label>CDP1804</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="CDP1805">
                    <label>CDP1805</label>
                    <radio>1</radio>
                </object>
            </object>
            <object class="wxMenu" name="CpuStartup">
                <label>Startup Values</label>
                <object class="wxMenu" name="MI_StartupRegisters">
                    <label>Registers</label>
                    <object class="wxMenuItem" name="StartupRegistersZeroed">
                        <label>Zero</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="StartupRegistersRandom">
                        <label>Random</label>
                        <radio>1</radio>
                    </object>
                </object>
                <object class="wxMenu" name="MI_StartupRam">
                    <label>RAM</label>
                    <object class="wxMenuItem" name="StartupRamZeroed">
                        <label>Zero</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="StartupRamRandom">
                        <label>Random</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="StartupRamDynamic">
                        <label>Dynamic</label>
                        <radio>1</radio>
                    </object>
                </object>
                <object class="wxMenu" name="MI_StartupVideoRam">
                    <label>Video RAM</label>
                    <object class="wxMenuItem" name="StartupVideoRamZeroed">
                        <label>Zero</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="StartupVideoRamRandom">
                        <label>Random</label>
                        <radio>1</radio>
                    </object>
                    <object class="wxMenuItem" name="StartupVideoRamDynamic">
                        <label>Dynamic</label>
                        <radio>1</radio>
                    </object>
                </object>
            </object>
            <object class="wxMenuItem" name="MI_FunctionKeys">
                <label>Function and Hot Keys</label>
            </object>
            <object class="wxMenuItem" name="MI_NumPad">
                <label>Use Numeric Keypad</label>
                <checkable>1</checkable>
            </object>
            <object class="wxMenu" name="KeyboardType">
                <label>Default Keyboard</label>
                <object class="wxMenuItem" name="KeyboardDutch">
                    <label>Dutch</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="KeyboardGerman">
                    <label>German</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="KeyboardFrench">
                    <label>French</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="KeyboardSwedish">
                    <label>Finnish / Swedish</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="KeyboardUs">
                    <label>US</label>
                    <radio>1</radio>
                </object>
                <object class="wxMenuItem" name="KeyboardUserDefined">
                    <label>Used Defined</label>
                    <radio>1</radio>
                </object>
            </object>
            <object class="wxMenuItem" name="MI_Sb">
                <label>COMX SuperBoard</label>
            </object>
        </object>
        <object class="wxMenu">
            <label>Help</label>
            <object class="wxMenuItem" name="wxID_HELP">
                <label>Help\tF1</label>
            </object>
            <object class="wxMenuItem" name="MI_Home">
                <label>Emma 02 Homepage</label>
            </object>
            <object class="wxMenu" name="ID_MENU5">
                <label>COMX SuperBoard</label>
                <object class="wxMenuItem" name="MI_Home_SB">
                    <label>Homepage</label>
                </object>
                <object class="wxMenuItem" name="MI_Home_SBHS">
                    <label>High Scores</label>
                </object>
            </object>
            <object class="separator">
            </object>
            <object class="wxMenuItem" name="MI_UpdateCheck">
                <label>Check for Update on Start-up</label>
                <checkable>1</checkable>
                <checked>1</checked>
            </object>
            <object class="wxMenuItem" name="MI_UpdateEmma">
                <label>Check for Update</label>
            </object>
            <object class="separator">
            </object>
            <object class="wxMenuItem" name="wxID_ABOUT">
                <label>About</label>
            </object>
        </object>
    </object>
    <object class="wxPanel" name="Main_GUI">
        <font>
            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
            <size>-1</size>
            <family>roman</family>
        </font>
        <object class="wxBoxSizer">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
                <flag>wxALIGN_LEFT</flag>
                <border>5</border>
                <object class="wxNotebook" name="Panels">
                    <font>
                        <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                        <size>-1</size>
                        <family>roman</family>
                    </font>
                    <style>wxWANTS_CHARS</style>
                    <object class="notebookpage">
                        <label>Computer</label>
                        <object class="wxPanel" name="Computer">
                            <font>
                                <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                <size>-1</size>
                                <family>roman</family>
                            </font>
                            <style>wxTAB_TRAVERSAL</style>
                            <object class="wxBoxSizer">
                                <orient>wxVERTICAL</orient>
                                <object class="sizeritem">
                                    <flag>wxALIGN_LEFT|wxALL</flag>
                                    <border>0</border>
                                    <object class="wxBoxSizer">
                                        <orient>wxHORIZONTAL</orient>
                                        <object class="sizeritem">
                                            <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                            <border>0</border>
                                            <object class="wxBoxSizer">
                                                <orient>wxVERTICAL</orient>
                                                <object class="sizeritem">
                                                    <flag>wxALIGN_LEFT|wxALL</flag>
                                                    <border>0</border>
                                                    <object class="wxBoxSizer">
                                                        <orient>wxHORIZONTAL</orient>
                                                        <object class="sizeritem">
                                                            <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                                            <border>3</border>
                                                            <object class="wxStaticText" name="wxID_STATIC">
                                                                <label>Configuration:</label>
                                                            </object>
                                                        </object>
                                                        <object class="sizeritem">
                                                            <flag>wxALIGN_CENTER_VERTICAL|wxLEFT|wxRIGHT</flag>
                                                            <border>3</border>
                                                            <object class="wxStaticText" name="ConfigTextXml">
                                                                <font>
                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                    <size>-1</size>
                                                                    <family>roman</family>
                                                                </font>
                                                                <label></label>
                                                            </object>
                                                        </object>
                                                    </object>
                                                </object>
                                                <object class="sizeritem">
                                                    <flag>wxALIGN_LEFT|wxALL</flag>
                                                    <border>0</border>
                                                    <object class="wxBoxSizer">
                                                        <orient>wxHORIZONTAL</orient>
                                                        <object class="sizeritem">
                                                            <flag>wxALIGN_TOP|wxLEFT|wxRIGHT|wxTOP</flag>
                                                            <border>3</border>
                                                            <object class="wxBoxSizer">
                                                                <orient>wxVERTICAL</orient>
                                                                <object class="sizeritem">
                                                                    <flag>wxGROW|wxBOTTOM</flag>
                                                                    <border>2</border>
                                                                    <object class="wxBoxSizer">
                                                                        <orient>wxHORIZONTAL</orient>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW</flag>
                                                                            <border>4</border>
                                                                            <option>20</option>
                                                                            <object class="wxChoice" name="MainDirXml">
                                                                                <size>166,-1</size>
                                                                                <tooltip>Select Computer</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                            </object>
                                                                        </object>
                                                                    </object>
                                                                </object>
                                                                <object class="sizeritem">
                                                                    <flag>wxALIGN_LEFT|wxBOTTOM</flag>
                                                                    <border>2</border>
                                                                    <object class="wxFlexGridSizer">
                                                                        <cols>2</cols>
                                                                        <rows>15</rows>
                                                                        <vgap>2</vgap>
                                                                        <hgap>0</hgap>
                                                                        <object class="sizeritem">
                                                                            <flag>wxALIGN_LEFT|wxALIGN_CENTER_VERTICAL</flag>
                                                                            <border>6</border>
                                                                            <object class="wxButton" name="XmlButtonXml">
                                                                                <tooltip>Browse for XML file</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                                <label>XML</label>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_TOP|wxTOP|wxBOTTOM</flag>
                                                                            <border>1</border>
                                                                            <object class="wxBoxSizer">
                                                                                <orient>wxHORIZONTAL</orient>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                                                                    <border>4</border>
                                                                                    <option>20</option>
                                                                                    <object class="wxComboBox" name="MainXmlXml">
                                                                                        <size>166,-1</size>
                                                                                        <tooltip>Specify XML file</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                        <style>wxCB_DROPDOWN</style>
                                                                                    </object>
                                                                                </object>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxALIGN_LEFT|wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                                                            <border>0</border>
                                                                            <object class="wxButton" name="RomRamButton0Xml">
                                                                                <tooltip>Browse for ROM or RAM file</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                                <label>ROM</label>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_TOP|wxTOP|wxBOTTOM</flag>
                                                                            <border>1</border>
                                                                            <object class="wxBoxSizer">
                                                                                <orient>wxHORIZONTAL</orient>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                                                                    <border>4</border>
                                                                                    <option>20</option>
                                                                                    <object class="wxComboBox" name="RomRam0Xml">
                                                                                        <size>166,-1</size>
                                                                                        <tooltip>Specify ROM or RAM file</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                        <style>wxCB_DROPDOWN</style>
                                                                                        <content>
                                                                                            <item></item>
                                                                                        </content>
                                                                                    </object>
                                                                                </object>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxALIGN_LEFT|wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                                                            <border>0</border>
                                                                            <object class="wxButton" name="RomRamButton1Xml">
                                                                                <tooltip>Browse for ROM or RAM file</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                                <label>RAM</label>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_TOP|wxTOP|wxBOTTOM</flag>
                                                                            <border>1</border>
                                                                            <object class="wxBoxSizer">
                                                                                <orient>wxHORIZONTAL</orient>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL</flag>
                                                                                    <border>4</border>
                                                                                    <option>20</option>
                                                                                    <object class="wxComboBox" name="RomRam1Xml">
                                                                                        <size>166,-1</size>
                                                                                        <tooltip>Specify ROM or RAM file</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                        <style>wxCB_DROPDOWN</style>
                                                                                        <content>
                                                                                            <item></item>
                                                                                        </content>
                                                                                    </object>
                                                                                </object>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxALIGN_LEFT|wxALIGN_CENTER_VERTICAL</flag>
                                                                            <border>3</border>
                                                                            <object class="wxButton" name="KeyFileButtonXml">
                                                                                <tooltip>Browse for key input file</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                                <label>Key File</label>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_CENTER_VERTICAL</flag>
                                                                            <border>2</border>
                                                                            <object class="wxBoxSizer">
                                                                                <orient>wxHORIZONTAL</orient>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                                                                    <border>0</border>
                                                                                    <option>20</option>
                                                                                    <object class="wxTextCtrl" name="KeyFileXml">
                                                                                        <size>166,22</size>
                                                                                        <tooltip>Specify key input file</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                    </object>
                                                                                </object>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                                                                    <border>4</border>
                                                                                    <object class="wxBitmapButton" name="EjectKeyFileXml">
                                                                                        <size>22,22</size>
                                                                                        <tooltip>Eject key input file</tooltip>
                                                                                        <bitmap>images_osx/eject.png</bitmap>
                                                                                    </object>
                                                                                </object>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxALIGN_LEFT|wxALIGN_CENTER_VERTICAL</flag>
                                                                            <border>3</border>
                                                                            <object class="wxButton" name="PrintFileButtonXml">
                                                                                <tooltip>Browse for printer output file</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                                <label>Printer</label>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_TOP</flag>
                                                                            <border>2</border>
                                                                            <option>20</option>
                                                                            <object class="wxBoxSizer">
                                                                                <orient>wxHORIZONTAL</orient>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                                                                    <border>0</border>
                                                                                    <object class="wxTextCtrl" name="PrintFileXml">
                                                                                        <size>90,22</size>
                                                                                        <tooltip>Specify printer output file</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                    </object>
                                                                                </object>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxTOP</flag>
                                                                                    <border>1</border>
                                                                                    <object class="wxChoice" name="PrintModeXml">
                                                                                        <size>75,-1</size>
                                                                                        <tooltip>Select print mode</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                        <content>
                                                                                            <item>File</item>
                                                                                            <item>Window</item>
                                                                                            <item>Plotter</item>
                                                                                        </content>
                                                                                    </object>
                                                                                </object>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
                                                                                    <border>4</border>
                                                                                    <object class="wxBitmapButton" name="PrintButtonXml">
                                                                                        <size>22,22</size>
                                                                                        <tooltip>Open printer window (F4)</tooltip>
                                                                                        <bitmap>images_osx/print.png</bitmap>
                                                                                        <selected>images_osx/print.png</selected>
                                                                                        <focus>images_osx/print.png</focus>
                                                                                    </object>
                                                                                </object>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxALIGN_LEFT|wxALIGN_CENTER_VERTICAL</flag>
                                                                            <border>2</border>
                                                                            <object class="wxButton" name="ScreenDumpFileButtonXml">
                                                                                <tooltip>Browse for video dump file</tooltip>
                                                                                <font>
                                                                                    <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                    <size>-1</size>
                                                                                    <family>roman</family>
                                                                                </font>
                                                                                <label>VideoDump</label>
                                                                            </object>
                                                                        </object>
                                                                        <object class="sizeritem">
                                                                            <flag>wxGROW|wxALIGN_TOP</flag>
                                                                            <border>2</border>
                                                                            <object class="wxBoxSizer">
                                                                                <orient>wxHORIZONTAL</orient>
                                                                                <object class="sizeritem">
                                                                                    <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                                                                    <border>0</border>
                                                                                    <option>20</option>
                                                                                    <object class="wxComboBox" name="ScreenDumpFileXml">
                                                                                        <size>166,-1</size>
                                                                                        <tooltip>Specify video dump file</tooltip>
                                                                                        <font>
                                                                                            <sysfont>wxSYS_DEFAULT_GUI_FONT</sysfont>
                                                                                            <size>-1</size>
                                                                                            <family>roman</family>
                                                                                        </font>
                                                                                        <style>wxCB_DROPDOWN</style>
