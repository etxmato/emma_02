$prefix=/usr
$bindir=${prefix}/bin
$datadir=${prefix}/share
$docdir=${datadir}/doc/emma_02
$libdir=/usr/lib
$mandir=${prefix}/share/man
$srcdir=.
%product Emma 02
%copyright 2007-2025 Marcel van Tongeren, core based on RCS Elf Emulator copyright 2006 by Michael H Riley.
%vendor Marcel van Tongeren <marcel.v.tongeren@gmail.com>
%license COPYING
%readme README
%description Emma 02 is emulating the CDP18S020 Evaluation Kit, COMX-35, COMiX-35, Cosmac Elf, Cosmac Elf 2000, Cosmac Microtutor I, Cosmac Microtutor II, Cosmac VIP, Cosmac VIP II, Cidelsa Arcade Game Console, Conic (Apollo, Mustang, MPT-02 and M1200), Cosmicos, Cybervision 2001, EFA-Datorn, ETI-660, FRED 1, FRED 1.5, HEC1802, HUG1802, Infinite UC1800, JVIP, Macbug, Membership Card, Netronics ELF II, Oscom Nano, PECOM 32, PECOM 64, Pico/Elf V2, Quest Super Elf, RCA COSMAC Computer Game System, RCA COSMAC Development System, RCA COSMAC Microboard Computer, RCA MicroDisk Development System MS2000, RCA Microboard Computer Development System, RCA Studio II, RCA Studio III, RCA Studio IV, RCA Video Coin Arcade Console, SBC1802, Studio 2020, Telmac 1800, Telmac 2000, Telmac TMC-600, VELF, VIP2K Membership Card, VIS1802, VP3000 Interactive Data Terminal, VT1802 and Visicom COM-100
%version 2.00
%requires glibc
%requires libcurl
%requires SDL
%requires gtk2
%requires wxGTK
%requires wxBase
%requires libserialport
# Executables
%system all
f 755 root sys ${bindir}/emma_02 ../Release/emma_02
# Application files
f 644 root sys ${datadir}/emma_02/pseudo.def ../pseudo.def
f 644 root sys ${datadir}/emma_02/amvbas.syntax ../amvbas.syntax
