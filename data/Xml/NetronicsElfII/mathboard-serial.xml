<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<emmaconfig>
    
    <system>
        <name>Netronics Elf II</name>
        <config>Giant Board and Full BASIC Math Board</config>
        <clock>1.76</clock>
        <boot>3</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <init ef="4">1</init>
        <dirname>NetronicsElfII</dirname>
    </system>
    
    <frontpanel init="on">
        <out>4</out>
        <in>4</in>
        <ef type="in">4</ef>
        <size>534, 386</size>
        <item>
            <type>png</type>
            <filename dirname="images">elf2.png</filename>
        </item>
        <item>
            <type>switch</type>
            <function>stop</function>
            <init>up</init>
            <pos>490, 20</pos>
        </item>
        <item>
            <type form="313" font="italic">til</type>
            <value>0</value>
            <function>datatil</function>
            <pos>370, 180</pos>
        </item>
        <item>
            <type form="313" font="italic">til</type>
            <value>1</value>
            <function>datatil</function>
            <pos>398, 180</pos>
        </item>
        <item>
            <type>led</type>
            <function>qled</function>
            <pos>440, 192</pos>
        </item>
        <item>
            <type>push</type>
            <init>up</init>
            <function>in</function>
            <label>IN</label>
            <pos>435, 327</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0xc</value>
            <label>C</label>
            <pos>304, 231</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0xd</value>
            <label>D</label>
            <pos>336, 231</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0xe</value>
            <label>E</label>
            <pos>368, 231</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0xf</value>
            <label>F</label>
            <pos>400, 231</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>8</value>
            <label>8</label>
            <pos>304, 263</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>9</value>
            <label>9</label>
            <pos>336, 263</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0xa</value>
            <label>A</label>
            <pos>368, 263</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0xb</value>
            <label>B</label>
            <pos>400, 263</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>4</value>
            <label>4</label>
            <pos>304, 295</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>5</value>
            <label>5</label>
            <pos>336, 295</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>6</value>
            <label>6</label>
            <pos>368, 295</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>7</value>
            <label>7</label>
            <pos>400, 295</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>0</value>
            <label>0</label>
            <pos>304, 327</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>1</value>
            <label>1</label>
            <pos>336, 327</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>2</value>
            <label>2</label>
            <pos>368, 327</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>push</type>
            <function>hex</function>
            <value>3</value>
            <label>3</label>
            <pos>400, 327</pos>
            <size>30, 30</size>
        </item>
        <item>
            <type>switch</type>
            <function>load</function>
            <init>down</init>
            <pos>440, 265</pos>
        </item>
        <item>
            <type>switch</type>
            <function>mp</function>
            <init>down</init>
            <pos>440, 295</pos>
        </item>
        <item>
            <type>switch</type>
            <function type="switch">run</function>
            <init>down</init>
            <pos>440, 235</pos>
        </item>
        <item>
            <type>led</type>
            <value>0</value>
            <function>mathled</function>
            <pos>376, 135</pos>
        </item>
        <item>
            <type>led</type>
            <value>1</value>
            <function>mathled</function>
            <pos>405, 135</pos>
        </item>
        <item>
            <type color="grey">text</type>
            <label>FB</label>
            <pos>375, 148</pos>
        </item>
        <item>
            <type color="grey">text</type>
            <label>FA</label>
            <pos>405, 148</pos>
        </item>
    </frontpanel>

     <memory>
         <rom type="gui">
             <start>0x0000</start>
             <end>0x017FF</end>
             <pulldown mask="*.bin">NetronicsElfII</pulldown>
             <filename verify="true">ELF II BASIC III ROM.bin</filename>
         </rom>

         <rom type="gui">
             <start>0xF000</start>
             <end>0xF0FF</end>
             <pulldown mask="giantboard*.*">NetronicsElfII</pulldown>
             <filename verify="true">giantboard.hex</filename>
         </rom>

         <giant>0xF000</giant>

         <ram>
            <start>0x2000</start>
            <end>0xEFFF</end>
        </ram>

    </memory>
    
    <vt type="vt100" connection="serial">
        <font>vt100.bin</font>
        <out>7</out>
        <ef pol="rev">4</ef>
        <q pol="rev"></q>
        <caps />
        <baud type="receive" correction="-5">300</baud>
        <baud type="transmit" correction="-5">300</baud>
        <border>0x0</border>
        <characters>64</characters>
        <backspace>0x7f</backspace>
        <color type="fore">0, 255, 0</color>
        <color type="back">0, 0x40, 0</color>
        <color type="high">0, 0xff, 0</color>
    </vt>

    <mm57109>
        <out>5</out>
        <in>2</in>
        <clock>0.4</clock>
        <ef pol="rev">2</ef>
    </mm57109>
            
    <cassette decks="1">
        <ef>2</ef>
    </cassette>
            
    <locations>
        <!-- key input -->
        <key_input>0x145f, 0x1310</key_input>

        <!-- Stop cassette -->
        <stop_cas>0x1300, 0xf029</stop_cas>
        
        <!-- Start SAVE, LOAD -->
        <start_cas_save>0x1149, 0xf08d</start_cas_save>
        <start_cas_load>0x1194, 0xf0cd</start_cas_load>
    </locations>

    <debugger>
        <scrt mode="on">
            <call reg="4">0x005e</call>
            <return reg="5">0x0070</return>
        </scrt>

        <assembler>
            <filename>mycode</filename>
            <code_start>0x2000</code_start>
            <code_end>0x2FFF</code_end>
        </assembler>

        <sep reg="7" bytes="2" address="0x007f">
            <string>LD   RD,</string>
            <byte_value>0xEF</byte_value> <!-- Last RAM page -->
            <byte_pc />
            <string>\nSEX  RD;LDA  RD</string>
            <string_exec>   D=M(</string_exec>
            <word_show_exec />
            <string_exec>)=</string_exec>
            <word_get_address_data>0</word_get_address_data>
        </sep>

        <sep reg="8" bytes="3" address="0x0089">
            <string>MOV  M(</string>
            <byte_value>0xEF</byte_value> <!-- Last RAM page -->
            <byte_pc />
            <word_save />
            <string>/</string>
            <word_show>1</word_show>
            <string>)\nTO   M(</string>
            <byte_value>0xEF</byte_value> <!-- Last RAM page -->
            <byte_pc />
            <string>/</string>
            <word_show>1</word_show>
            <string>)</string>
            <string_exec>=</string_exec>
            <word_load>0</word_load>
            <word_get_address_data>0</word_get_address_data>
            <word_get_address_data>1</word_get_address_data>
        </sep>
    
        <sep reg="0xe" bytes="1" address="0x1136">
            <string>WAV  Q</string>
            <string_exec>DF=</string_exec>
            <df />
        </sep>

    </debugger>

</emmaconfig>
