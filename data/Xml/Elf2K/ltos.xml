<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<emmaconfig>

    <system>
        <name>COSMAC Elf 2000</name>
        <config>LTOS - UART VT</config>
        <clock>3.5795</clock>
        <boot>0</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">0</init>
        <init ef="4">1</init>
        <dirname>Elf2K</dirname>
    </system>

    <splash>
        <text>To start the Elf2K for the first time:&#xD;- Wait for the hexadecimal display to show 16&#xD;- Press 'return' to set default baud rate&#xD;- Baud rate will be stored in non-volatile RAM</text>
    </splash>

    <iogroup>
        <out mask="0x90">2</out>
    </iogroup>

    <bootstrap>
        <address>0x8000</address>
    </bootstrap>

    <hexmodem>
    </hexmodem>

    <sound type="q">
        <hw>700</hw>
    </sound>

    <frontpanel init="on">
        <out>4</out>
        <in>4</in>
        <ef type="in">4</ef>
        <size>507, 459</size>
        <item>
            <type>png</type>
            <filename dirname="images">Elf2K.png</filename>
        </item>
        <item>
            <type form="elf2k_power">switch</type>
            <function>stop</function>
            <init>down</init>
            <pos>480, 71</pos>
        </item>
        <item>
            <type form="311">til</type>
            <value>0</value>
            <function>datatil</function>
            <pos>301, 354</pos>
        </item>
        <item>
            <type form="311">til</type>
            <value>1</value>
            <function>datatil</function>
            <pos>337, 354</pos>
        </item>
        <item>
            <type form="311">til</type>
            <value>0</value>
            <function>addresstil</function>
            <pos>147, 354</pos>
        </item>
        <item>
            <type form="311">til</type>
            <value>1</value>
            <function>addresstil</function>
            <pos>182, 354</pos>
        </item>
        <item>
            <type form="311">til</type>
            <value>2</value>
            <function>addresstil</function>
            <pos>217, 354</pos>
        </item>
        <item>
            <type form="311">til</type>
            <value>3</value>
            <function>addresstil</function>
            <pos>252, 354</pos>
        </item>
        <item>
            <type form= "realorange">led</type>
            <function>qled</function>
            <pos>50, 354</pos>
        </item>
        <item>
            <type form= "realred">led</type>
            <function>runled</function>
            <pos>48, 309</pos>
        </item>
        <item>
            <type form= "realgreen">led</type>
            <function>loadled</function>
            <pos>51, 333</pos>
        </item>
        <item>
            <type form= "realorange">led</type>
            <value>1</value>
            <function cycle="show">cpustateled</function>
            <pos>50, 379</pos>
        </item>
        <item>
            <type form= "realorange">led</type>
            <value>0</value>
            <function cycle="show">cpustateled</function>
            <pos>50, 401</pos>
        </item>
    </frontpanel>

    <memory>
        <rom type="gui" mask="0xffff">
            <start>0x8000</start>
            <end>0xFFFF</end>
            <pulldown mask="Elf2Kv*.*">Elf2K</pulldown>
            <filename verify="true">Elf2Kv112.bin</filename>
        </rom>

        <nvram type="gui">
            <start>0x0000</start>
            <end>0x7FFF</end>
            <dump>ltos-ram.bin</dump>
        </nvram>
    </memory>

    <disk type="ide">
        <filename>ltos-card.ide</filename>
        <dirname>Elf2K</dirname>
        <out type="select">2</out>
        <out type="write">3</out>
        <in type="status">2</in>
        <in type="read">3</in>
        <tracks>512</tracks>
        <heads>4</heads>
        <sectors>26</sectors>
        <iogroup>0</iogroup>
    </disk>

    <vt type="vt100" connection="uart16450" >
        <font>vt100.bin</font>
        <out type="select">2</out>
        <out type="port">3</out>
        <in type="status">2</in>
        <in type="port">3</in>
        <baud type="receive">19200</baud>
        <baud type="transmit">19200</baud>
        <characters>80</characters>
        <iogroup>0x10</iogroup>
        <border>5x5</border>
        <color type="fore">0, 255, 0</color>
        <color type="back">0, 0x40, 0</color>
        <color type="high">0, 0xff, 0</color>
     </vt>

     <rtc type="ds12887">
        <out type="select">2</out>
        <out type="write">3</out>
        <in>3</in>
        <iogroup>0x80, 0x90</iogroup>
</rtc>


</emmaconfig>
