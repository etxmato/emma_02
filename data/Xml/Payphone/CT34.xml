<?xml version="1.0" encoding="utf-8"?>
<emmaconfig>
  <system>
    <name>CT Payphone</name>
    <config>V15.0 CT34</config>
    <clock>2.0</clock>
    <cpu>1802</cpu>
    <boot >0x0000</boot> 
    <init type="ef1">1</init>
    <init type="ef2">1</init>
    <init type="ef3">1</init>
    <init type="ef4">1</init>
    <dirname>Payphone</dirname>
    <int>2000</int>
  </system>
  <splash>
    <text>Press return to send SPM pulse.
	</text>
  </splash>


	<payphone>

		<in type="sensors">1</in>		<!-- input port to read sensors -->
		<in type="coins">3</in>			<!-- input port to read coins -->
		<out type="validator">2</out>	<!-- output port for validator (only bit 2) -->
		<out type="gates">4</out>		<!-- output port for gates and leds -->
		<out type="control">5</out>		<!-- output port for phone control (only bit 6 and 7) -->
		<ef type="spm">2</ef>			<!-- ef flag trigggered by SPM -->

        <timer type="ignore_led">400</timer>        <!-- timer to ignore led flashes (for gate 6) in microseconds (100 cycles) -->
        <timer type="spm_interval">10</timer>       <!-- timer for SPM interval in seconds -->

                                                    <!-- all follwong times are set in ms, Emma 02 will convert these
                                                         on start up to cpuCycles (using the set clock speed) -->
		<timer type="before_1">12</timer>			<!-- timer for coin travel to sensor 1 (3000 cycles) -->
		<timer type="block_1">24</timer>			<!-- timer for coin block of sensor 1 (6000 cycles) -->
		<timer type="between_1_2">28</timer>		<!-- timer for coin travel from sensor 1 to 2 (7000 cycles) -->
		<timer type="block_2">21</timer>			<!-- timer for coin block of sensor 2 (5250 cycles) -->
		<timer type="between_2_x">240</timer>		<!-- timer for coin travel from sensor 2 to 3/4 (60000 cycles) -->
		<timer type="after_gate_5_6">196</timer>	<!-- timer for coin travel from gate 5 and 6 to sensor 5 (49000 cycles) -->
		<timer type="block_5">16</timer>			<!-- timer for coin block of sensor 5 (4000 cycles) -->
		<timer type="spm_pulse">113</timer>		    <!-- timer for SPM pulse width (28250 cycles) -->
        
		<sensor type="after_gate_1">1</sensor>		<!-- sensor number after gate 1 -->
		<sensor type="after_gate_2">2</sensor>		<!-- sensor number after gate 2 -->
		<sensor type="lower_escrow">3</sensor>		<!-- sensor number in the lower escrow -->
		<sensor type="upper_escrow">4</sensor>		<!-- sensor number in the upper escrow -->
		<sensor type="return">5</sensor>			<!-- sensor number in the return basket -->
		<gate type="first">1</gate>					<!-- first gate number -->
		<gate type="second">2</gate>				<!-- second gate number -->
		<gate type="lower_escrow_cash">5</gate>		<!-- gate number in upper escrow to cash box -->
		<gate type="upper_escrow_cash">6</gate>		<!-- gate number in lower escrow to cash box -->
		<gate type="lower_escrow_return">3</gate>	<!-- gate number in upper escrow to return box -->
		<gate type="upper_escrow_return">4</gate>	<!-- gate number in lower escrow to return box -->

	</payphone>
  
