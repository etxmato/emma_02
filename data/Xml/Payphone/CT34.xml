	<!-- EF1 is normal serial input on both CT24/25 and 34, EF4 can be used as alternate on some CT34-based systems.
		 EFs are active low. This is dealt with in firmware. Hardwere does not invert Q, the serial output, so we have to invert.
		 It appears that EMMA overrides this definition by any set on the EMMA console :-(
		 Note: Just to add confusion, both transmit and receive are hardware inverted on the tester. -->
	
	<!--	<vt type="vt100" connection="serial">
		<font>vt100.bin</font>
		<bits>7</bits>
		<ef>4</ef>
		<q pol="rev"></q>
		<caps />
		<baud type="receive">1200</baud>
		<baud type="transmit">1200</baud>
		<border>0x0</border>
		<color type="fore">0, 255, 0</color>
		<color type="back">0, 0x40, 0</color>
		<color type="high">0, 0xff, 0</color>
	</vt>-->

	<vt type="external" connection="serial">
		<!--<ef>1</ef>
		<q pol="rev"></q>-->
		<ef pol="rev">1</ef>
		<q></q>		
		<serialport>COM3</serialport>
		<bits>7</bits>
		<parity>on</parity>
		<parity_sense>odd</parity_sense>

		<baud type="receive">1200</baud>
		<baud type="transmit">1200</baud>
		<stopbit>2</stopbit>
	</vt>

