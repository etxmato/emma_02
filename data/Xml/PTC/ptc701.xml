<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<emmaconfig>

    <system>
        <name>PTC</name>
        <config>PTC-701 McDonald's Terminal</config>
        <clock>2.4576</clock>
        <boot>0</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <init ef="4">1</init>
        <dirname>PTC</dirname>
    </system>

    <memory>
        <!-- System ROM: 16K at 0x0000-0x3FFF -->
        <rom type="gui">
            <start>0x0000</start>
            <end>0x3F00</end>
            <pulldown mask="ptc701*.bin">PTC</pulldown>
            <filename verify="true">ptc701.bin</filename>
        </rom>

        <ram>
            <start>0x3f00</start>
            <end>0x3fFF</end>
        </ram>

        <!-- Application ROM: 32K at 0x4000-0xBFFF (McDonald's inventory v3.0) -->
        <rom>
            <start>0x4000</start>
            <end>0xBFFF</end>
            <filename verify="true">ptcmcd.bin</filename>
        </rom>

        <!-- RAM: 8K at 0x6000-0x7FFF (overlaps app ROM via banking) -->
        <ram>
            <start>0x6000</start>
            <end>0x7FFF</end>
        </ram>
    </memory>

    <video type="hd44780">
        <!-- HD44780-compatible 2x16 character LCD display
        Interface via AMI 9217MLB custom gate array (memory-mapped I/O):
        - 0x3F80: command register (RS=0) — HD44780 instruction writes
        - 0x3F81: data register (RS=1) — character data writes
        - 0x3FA0: status register — bit 0 = busy flag

        Character ROM: hd44780u_a00.bin (4096 bytes, standard HD44780 CGROM)
        Must be obtained from MAME romset or generated from datasheet.
        -->

        <font>hd44780u_a00.bin</font>
        <dirname>PTC</dirname>
        <out type="command">0x3F80</out>
        <out type="data">0x3F50</out>
        <in type="status">0x3FA0</in>
        <ef>1</ef>
        <screen>16x2</screen>
        <char>5x8</char>
        <zoom>4.00</zoom>
        <border>4x4</border>
        <color type="fore">0, 0, 0</color>
        <color type="back">0x9E, 0xB5, 0x5B</color>
    </video>

    <keyboard type="matrix">
        <!-- PTC-701 keyboard: 35 keys, scanned by AMI 9217MLB gate array
        Memory-mapped keyboard scan buffer at 0x3F20-0x3F25 (6 columns, 8 bits each)
        Bit = 1: key pressed (active high), Bit 7 scanned first (MSB)
        addressmask 0x07: matches 0x3F20-0x3F27, indexes keyValue_[0..7]
        
        Verified scan matrix (from ptcmcd.bin offset 0x0013):
        Col 0x3F20: bit7=—, bit6=—, bit5=—, bit4=I, bit3=A, bit2=B, bit1=C, bit0=—
        Col 0x3F21: bit7=G, bit6=D, bit5=E, bit4=F, bit3=H, bit2=—, bit1=J, bit0=K
        Col 0x3F22: bit7=L, bit6=M, bit5=N, bit4=—, bit3=O, bit2=P, bit1=CLEAR, bit0=SHIFT
        Col 0x3F23: bit7=SPACE, bit6=—, bit5=—, bit4=LEFT, bit3=7, bit2=8, bit1=9, bit0=SYS-MODE
        Col 0x3F24: bit7=—, bit6=RIGHT, bit5=4, bit4=5, bit3=6, bit2=—, bit1=—, bit0=ENTER
        Col 0x3F25: bit7=1, bit6=2, bit5=3, bit4=—, bit3=—, bit2=., bit1=-, bit0=0
        -->

        <in addressmask="0x07">0x3F20</in>

        <!-- Column 0 (0x3F20) -->
        <keydef address="0" bit="4">73</keydef>     <!-- I (SEARCH) -->
        <keydef address="0" bit="3">65</keydef>     <!-- A (UPDATE) -->
        <keydef address="0" bit="2">66</keydef>     <!-- B (SET UP) -->
        <keydef address="0" bit="1">67</keydef>     <!-- C (INVENT) -->

        <!-- Column 1 (0x3F21) -->
        <keydef address="1" bit="7">71</keydef>     <!-- G (ADD ON) -->
        <keydef address="1" bit="6">68</keydef>     <!-- D (REVIEW) -->
        <keydef address="1" bit="5">69</keydef>     <!-- E (EDIT) -->
        <keydef address="1" bit="4">70</keydef>     <!-- F (SEND) -->
        <keydef address="1" bit="3">72</keydef>     <!-- H (EXIT) -->
        <keydef address="1" bit="1">74</keydef>     <!-- J (INSERT) -->
        <keydef address="1" bit="0">75</keydef>     <!-- K (BCKSP) -->

        <!-- Column 2 (0x3F22) -->
        <keydef address="2" bit="7">76</keydef>     <!-- L (DELETE) -->
        <keydef address="2" bit="6">77</keydef>     <!-- M (MODIFY) -->
        <keydef address="2" bit="5">78</keydef>     <!-- N (NO) -->
        <keydef address="2" bit="3">79</keydef>     <!-- O (LOOK UP) -->
        <keydef address="2" bit="2">80</keydef>     <!-- P (YES) -->
        <keydef address="2" bit="1">127</keydef>    <!-- CLEAR → PC Delete key -->
        <keydef address="2" bit="0">113</keydef>    <!-- SHIFT → PC 'q' key -->

        <!-- Column 3 (0x3F23) -->
        <keydef address="3" bit="7">32</keydef>     <!-- SPACE -->
        <keydef address="3" bit="3">55</keydef>     <!-- 7 -->
        <keydef address="3" bit="2">56</keydef>     <!-- 8 -->
        <keydef address="3" bit="1">57</keydef>     <!-- 9 -->
        <keydef address="3" bit="0">9</keydef>      <!-- SYS-MODE → PC TAB key -->

        <!-- Column 4 (0x3F24) -->
        <keydef address="4" bit="5">52</keydef>     <!-- 4 -->
        <keydef address="4" bit="4">53</keydef>     <!-- 5 -->
        <keydef address="4" bit="3">54</keydef>     <!-- 6 -->
        <keydef address="4" bit="0">13</keydef>     <!-- ENTER → PC Return key -->

        <!-- Column 5 (0x3F25) -->
        <keydef address="5" bit="7">49</keydef>     <!-- 1 -->
        <keydef address="5" bit="6">50</keydef>     <!-- 2 -->
        <keydef address="5" bit="5">51</keydef>     <!-- 3 -->
        <keydef address="5" bit="2">46</keydef>     <!-- . (period) -->
        <keydef address="5" bit="1">45</keydef>     <!-- - (minus) -->
        <keydef address="5" bit="0">48</keydef>     <!-- 0 -->

        <!-- Arrow keys (text type for special keys) -->
        <keydef type="text" address="3" bit="4">left</keydef>   <!-- LEFT arrow -->
        <keydef type="text" address="4" bit="6">right</keydef>  <!-- RIGHT arrow -->
        <keydef type="text" address="4" bit="0">return</keydef> <!-- ENTER (duplicate for Return key) -->

    </keyboard>

    <vt type="loop_back" connection="serial">
        <!-- Bit-banged RS-232 serial communication
        TX: Q line (SEQ = mark/1, REQ = space/0)
        RX: EF4 (B4/BN4 for bit sampling)
        Handshake: EF2 for CTS/DSR

        Baud rate determined by firmware timing loops.
        Common rates for POS terminals: 1200, 2400, 4800 baud
        -->

        <font>vt100.bin</font>
        <q pol="rev"></q>
        <ef pol="rev">4</ef>
        <baud type="receive">1200</baud>
        <baud type="transmit">1200</baud>
    </vt>

    <debugger>
        <scrt mode="on">
            <!-- Standard SCRT: R4=call, R5=return
            Based on ROM analysis, R2 is used for SEP-based subroutines,
            but standard SCRT also appears in the code -->
            <call reg="4">0x04E2</call>
            <return reg="5">0x04E4</return>
        </scrt>

        <assembler>
            <filename>ptc701</filename>
            <code_start>0x0000</code_start>
            <code_end>0x3F00</code_end>
        </assembler>

        <!-- Force counter addresses to return 0 (no hardware counter present in emulation) -->
        <read_value value="0x00">0x600A, 0x600B</read_value>
    </debugger>

</emmaconfig>
