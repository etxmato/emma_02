<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<emmaconfig>

    <system>
        <name>PTC</name>
        <config>PTC-701 McDonald's Terminal</config>
        <clock>2.4576</clock>
        <boot>0</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <init ef="4">1</init>
        <dirname>PTC</dirname>
    </system>

    <memory>
        <!-- System ROM: 16K at 0x0000-0x3FFF -->
        <rom type="gui">
            <start>0x0000</start>
            <end>0x3EBE</end>
            <pulldown mask="ptc701*.bin">PTC</pulldown>
            <filename verify="true">ptc701.bin</filename>
        </rom>

        <!-- Application ROM: 32K at 0x4000-0xBFFF (McDonald's inventory v3.0) -->
        <rom>
            <start>0x4000</start>
            <end>0xBFFF</end>
            <filename verify="true">ptcmcd.bin</filename>
        </rom>

        <!-- RAM: 8K at 0x6000-0x7FFF (overlaps app ROM via banking) -->
        <ram>
            <start>0x6000</start>
            <end>0x7FFF</end>
        </ram>
    </memory>

    <video type="hd44780">
        <!-- HD44780-compatible 2x16 character LCD display
        Interface via AMI 9217MLB custom gate array:
        - OUT 1: display address/position (maps to HD44780 set DDRAM address command)
        - OUT 2: display character data (maps to HD44780 data write)
        - INP 2: status (maps to HD44780 busy flag read)
        - EF1: display ready signal

        Character ROM: hd44780u_a00.bin (4096 bytes, standard HD44780 CGROM)
        Must be obtained from MAME romset or generated from datasheet.
        -->

        <font>hd44780u_a00.bin</font>
        <dirname>PTC</dirname>
        <out type="command">1</out>
        <out type="data">2</out>
        <in type="status">2</in>
        <ef>1</ef>
        <screen>16x2</screen>
        <char>5x8</char>
        <pixelsize>3</pixelsize>
        <zoom>2.00</zoom>
        <border>4x4</border>
        <color type="fore">0, 0, 0</color>
        <color type="back">0x9E, 0xB5, 0x5B</color>
    </video>

    <keyboard type="bit">
        <!-- PTC-701 keyboard: 35 keys (7 columns x 5 rows)
        Keyboard scan: OUT 3 selects column, INP 3 reads row (via AMI chip)
        
        Key layout from ptcmcd.bin:
        Row 1: - i A B C D E F
        Row 2: 7 8 9
        Row 3: 4 5 6
        Row 4: 1 2 3
        Bottom: 0 . CE
        Function: x(multiply) y(yes) e(enter) r(repeat) s(send)
        -->

        <out>3</out>
        <in>3</in>
        <!-- Key mapping TBD based on further ROM analysis -->
    </keyboard>

    <serial type="bit">
        <!-- Bit-banged RS-232 serial communication
        TX: Q line (SEQ = mark/1, REQ = space/0)
        RX: EF4 (B4/BN4 for bit sampling)
        Handshake: EF2 for CTS/DSR

        Baud rate determined by firmware timing loops.
        Common rates for POS terminals: 1200, 2400, 4800 baud
        -->

        <q pol="rev"></q>
        <ef pol="rev">4</ef>
        <baudrate>1200</baudrate>
    </serial>

    <debugger>
        <scrt mode="on">
            <!-- Standard SCRT: R4=call, R5=return
            Based on ROM analysis, R2 is used for SEP-based subroutines,
            but standard SCRT also appears in the code -->
            <call reg="4">0x04E2</call>
            <return reg="5">0x04E4</return>
        </scrt>

        <assembler>
            <filename>ptc701</filename>
            <code_start>0x0000</code_start>
            <code_end>0x3EBE</code_end>
        </assembler>
    </debugger>

</emmaconfig>
