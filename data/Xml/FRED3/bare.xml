        <item>
            <type>dipswitch</type>
            <value>0</value>
            <function>inp_bitswitch</function>
            <in>5</in>
            <init>down</init>
            <pos>245, 58</pos>
        </item>
        <item>
            <type>dipswitch</type>
            <value>1</value>
            <function>inp_bitswitch</function>
            <in>5</in>
            <init>down</init>
            <pos>256, 58</pos>
        </item>
        <item>
            <type>dipswitch</type>
            <value>2</value>
            <function>inp_bitswitch</function>
            <in>5</in>
            <init>down</init>
            <pos>267, 58</pos>
        </item>
        <item>
            <type>dipswitch</type>
            <value>3</value>
            <function>inp_bitswitch</function>
            <in>5</in>
            <init>down</init>
            <pos>278, 58</pos>
        </item>
