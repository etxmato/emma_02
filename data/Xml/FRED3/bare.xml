<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<emmaconfig>
    
    <system>
        <name>FRED 3</name>
        <config>Bare (select game file in ROM field)</config>
        <clock>1.6</clock>
        <cpu>1801</cpu>
        <boot>0</boot>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <init ef="4">1</init> 
        <dirname>FRED3</dirname>
    </system>

