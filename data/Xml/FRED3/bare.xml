        </item>
        <item>
            <type>text</type>
            <label>OFF</label>
            <pos>120, 80</pos>
        </item>
        <item>
            <type>text</type>
            <label>-</label>
            <pos>160, 80</pos>
        </item>
        <item>
            <type>text</type>
            <label>-</label>
            <pos>190, 80</pos>
        </item>
        <item>
            <type>text</type>
