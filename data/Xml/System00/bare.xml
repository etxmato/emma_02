<?xml version="1.0"?>
<!DOCTYPE emmaconfig SYSTEM "emma02.dtd">

<emmaconfig>

    <system>
        <name>System 00</name>
        <config>Bare</config>
        <clock>1.00</clock>
        <cpu>system</cpu>
        <boot dma="out" start="no">0</boot>
        <dma_in>reset</dma_in>
        <init ef="1">1</init>
        <init ef="2">1</init>
        <init ef="3">1</init>
        <init ef="4">1</init>
        <dirname>System00</dirname>
    </system>

    <gui>
        <auto>on</auto>
        <turbo>off</turbo>
    </gui>

    <iogroup>
        <out>1</out>
    </iogroup>

    <frontpanel init="on">
        <size>518, 249</size>

        <!-- Title -->

        <!-- LEFT SECTION: Primary Controls & System Indicators -->

        <!-- Column 1: ST / RS / READ / LED1 -->
        <item><type>push</type><label>ST</label><function>run</function><pos>15, 6</pos><size>25, 25</size></item>
