    </frontpanel>

    <memory>
        <ram type="gui" mask="0x3ff">
            <start>0x0000</start>
            <end>0x03FF</end>
            <pulldown mask="*.bin">System00</pulldown>
        </ram>
    </memory>

    <keypad type="fred">
        <iogroup>1</iogroup>
        <out>2</out>
        <in type="key" mode="1">0</in>
        <ef type="key" mode="1">1</ef>
        <mode>hex</mode>
    </keypad>

    <video type="fred">
        <iogroup>2</iogroup>
        <out>2</out>
        <border>33x33</border>
        <color type="fore">255, 255, 255</color>
        <color type="back">0, 0, 0</color>
    </video>

    <cassette type="fred">
        <iogroup>3</iogroup>
        <stoptone />
        <bootstart />
        <ef type="in" mode="2">1</ef>
        <ef type="run">2</ef>
        <ef type="error">4</ef>
        <in mode="2">0</in>
        <out type="mode">2</out>
        <out type="sound">3</out>
        <freq type="0">5200</freq>
        <freq type="1">6200</freq>
        <databits>8</databits>
        <threshold type="8bit">10</threshold>
        <threshold type="16bit">500</threshold>
        <threshold type="24bit">1000</threshold>
    </cassette>

    <debugger>
        <scrt mode="off">
            <call reg="4">-1</call>
            <return reg="5">-1</return>
        </scrt>

        <assembler>
            <filename>fred.bin</filename>
            <code_start>0</code_start>
            <code_end>0x3FF</code_end>
        </assembler>
    </debugger>

</emmaconfig>
